{
  "name": "ai-logic-reviewer",
  "displayName": "AI 逻辑审查",
  "description": "基于 DeepSeek 的前端代码逻辑审查工具",
  "version": "0.0.1",
  "publisher": "fgt12313",
  "repository": {
    "type": "git",
    "url": "https://github.com/fgt12313/vscode-ai-logic-reviewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:ai-reviewer.reviewFile",
    "onCommand:ai-reviewer.reviewPackage",
    "onCommand:ai-reviewer.reviewWorkspace",
    "onCommand:ai-reviewer.setApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "ai-reviewer.reviewFile",      "title": "AI 审查：当前文件" },
      { "command": "ai-reviewer.reviewPackage",   "title": "AI 审查：当前包" },
      { "command": "ai-reviewer.reviewWorkspace", "title": "AI 审查：整个项目" },
      { "command": "ai-reviewer.setApiKey",       "title": "AI 审查：设置 DeepSeek Key" }
    ],
    "menus": {
       "editor/context": [
        { "command": "ai-reviewer.reviewFile",    "group": "navigation@1" },
        { "command": "ai-reviewer.reviewPackage", "group": "navigation@2" }
      ],
      "explorer/context": [
        { "command": "ai-reviewer.reviewPackage",   "group": "navigation@1", "when": "explorerResourceIsFolder" },
        { "command": "ai-reviewer.reviewWorkspace", "group": "navigation@2", "when": "explorerResourceIsFolder" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^9.0.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0"
  }
}